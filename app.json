{
  "expo": {
    "name": "LunChips",
    "slug": "lunchips",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/coinfin.png",
    "userInterfaceStyle": "light",
    "scheme": "lunchips",
    "sdkVersion": "54.0.0",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pokerhost.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/coinfin.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.pokerhost.app"
    },
    "web": {
      "favicon": "./assets/icons/coinfin.png",
      "bundler": "metro",
      "name": "LunChips",
      "shortName": "LunChips",
      "lang": "zh-TW",
      "dir": "ltr",
      "scope": "/",
      "themeColor": "#10B981",
      "backgroundColor": "#1A1A1A",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "portrait",
      "dangerouslySetInnerHTML": true,
      "build": {
        "babel": {
          "include": [
            "@expo/vector-icons"
          ]
        }
      }
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "0a3c34f2-33cc-4893-abdc-5c2159d3059b"
      },
      "apiUrl": "https://lunchips.com/api"
    }
  }
}
